node_modules
dist
*.log
.DS_Store
.playwright-mcp

# Never commit secrets or local config
.env
.env.*
*.pem
*.key
.npmrc
.vscode/
.idea/
.vercel
.env*

# PlatformIO build output (firmware/)
.pio/
# …and what pioarduino writes next to platformio.ini when it rebuilds the core (custom_sdkconfig)
firmware/**/managed_components/
firmware/**/CMakeLists.txt
firmware/**/.dummy/
firmware/**/sdkconfig.*
firmware/**/sdkconfig.defaults
firmware/**/dependencies.lock
# A board's Home Assistant webhook (its ID is the only thing guarding it)
firmware/**/HomeAssistantConfig.h

# Your own apps: their own repo (npm run my-apps sets it up)
/my-apps/

# The native app: its own private repo
/apple/

# Local agent tooling: installed skills and their lock file
/.agents/
/.claude/
/skills-lock.json
